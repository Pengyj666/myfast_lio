<launch>
  <!-- Launch file for vanjee722f VLP-16 LiDAR -->

    <arg name="rviz" default="true" />

    <param name="map_voxel_size" type="double" value="0.2"/>
    <param name="scan_voxel_size" type="double" value="0.2" />
    <param name="freq_localization" type="double" value="10" />
    <param name="localization_th" type="double" value="0.1" />
    <param name="lidar_d" type="double" value="-6.7" />
    <param name="map_file_path" type="string" value="/home/edy/code/mower_ws/src/mower_localization/lidar_localization_ros/map/lmap.pcd" />
    <param name="odom_file_path" type="string" value="odometry_data.txt" />
    <node pkg="lidar_localization_ros" type="fast_lio_localization" name="fast_lio_localization" output="screen" /> 

    <arg name="map" default="" />
    <!-- loalization-->
    <!-- <node pkg="fast_lio_localization" type="fastlio_mapping" name="global_localization" output="screen" /> -->

    <!-- 启动坐标变换融合节点 -->
    <!-- <node pkg="lidar_localization_ros" type="transform_fusion" name="transform_fusion" output="screen">
        <param name="freq_pub_localization" value="50.0"/>
    </node> -->

    <!-- glbal map-->
    <!-- <node pkg="pcl_ros" type="pcd_to_pointcloud" name="map_publishe" output="screen"
          args="$(arg map) 5 _frame_id:=/map cloud_pcd:=/map" /> -->
    <group if="$(arg rviz)">
    <!-- <node launch-prefix="nice" pkg="rviz" type="rviz" name="rviz" args="-d $(find lidar_localization_ros)/rviz/localization.rviz"/> -->
    </group>

</launch>

